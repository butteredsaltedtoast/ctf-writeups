<div class="shooting-stars" aria-hidden="true"></div>

<script>
// @ts-nocheck

    function reducedMotion() {
        return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    }

    function spawnTwinkle(x, y, container) {
        const t = document.createElement('span');
        t.classList.add('star-twinkle');
        t.textContent = '✦';
        t.style.left = `${x}px`;
        t.style.top = `${y}px`;
        container.appendChild(t);
        t.addEventListener('animationend', () => t.remove());
    }

    function getLandingSpot() {
        const W = window.innerWidth;
        const H = window.innerHeight;

        const zoneW = Math.min(760, W * 0.92);
        const zoneLeft = (W - zoneW) / 2;
        const zoneRight = zoneLeft + zoneW;
        const zoneBottom = H * 0.75;

        let x = 0;
        let y = 0;
        for (let i = 0; i < 12; i++) {
            x = W * (0.06 + Math.random() * 0.88);
            y = H * (0.1 + Math.random() * 0.7);
            const insideContent = x > zoneLeft && x < zoneRight && y < zoneBottom;
            if (!insideContent) break;
        }
        return { x, y };
    }

    function createShootingStar() {
        const container = document.querySelector('.shooting-stars');
        if (!container) return;

        const len = Math.random() * 120 + 100;
        const dur = Math.random() * 0.6 + 0.8;
        const angle = 150 + Math.random() * 15;
        const travel = Math.random() * 500 + 800;
        const rad = angle * Math.PI / 180;

        const { x: endX, y: endY } = getLandingSpot();

        const startX = endX - len - Math.cos(rad) * travel;
        const startY = endY - Math.sin(rad) * travel;

        const star = document.createElement('div');
        star.classList.add('shooting-star');
        star.style.left = `${startX}px`;
        star.style.top = `${startY}px`;
        star.style.setProperty('--len', `${len}px`);
        star.style.setProperty('--dur', `${dur}s`);
        star.style.setProperty('--angle', `${angle}deg`);
        star.style.setProperty('--travel', `${travel}px`);

        container.appendChild(star);
        star.addEventListener('animationend', () => {
            spawnTwinkle(endX, endY, container);
            star.remove();
        });
    }

    function schedule() {
        const delay = Math.random() * 1500 + 333;
        setTimeout(() => {
            if (!reducedMotion()) createShootingStar();
            schedule();
        }, delay);
    }

    if (!reducedMotion() && !window.__shootingStarsStarted) {
        window.__shootingStarsStarted = true;
        schedule();
    }

</script>

<style is:global>

    .shooting-stars {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: -1;
        overflow: hidden;
    }

    .shooting-star {
        position: absolute;
        width: var(--len, 180px);
        height: 2px;
        background: linear-gradient(
            90deg,
            rgba(255, 217, 125, 0) 0%,
            rgba(255, 217, 125, 0.6) 60%,
            #FFF6DC 100%
        );
        border-radius: 999px;
        opacity: 0;
        transform-origin: right center;
        filter: drop-shadow(0 0 6px rgba(255, 217, 125, 0.55));
        animation: shoot var(--dur, 1.6s) linear forwards;
    }

    @keyframes shoot {
        0%   { opacity: 0; transform: rotate(var(--angle, 135deg)) translateX(0) scaleX(0); }
        8%   { opacity: 1; }
        35%  { transform: rotate(var(--angle, 135deg)) translateX(calc(var(--travel, 1200px) * 0.35)) scaleX(1); }
        85%  { opacity: 1; }
        100% { opacity: 0; transform: rotate(var(--angle, 135deg)) translateX(var(--travel, 1200px)) scaleX(1); }
    }

        .star-twinkle {
        position: absolute;
        color: #FFF6DC;
        font-size: 0.9rem;
        pointer-events: none;
        transform: translate(-50%, -50%);
        filter: drop-shadow(0 0 6px rgba(255, 217, 125, 0.7));
        animation: twinkle-pop 0.8s ease-out forwards;
    }

    @keyframes twinkle-pop {
        0%   { opacity: 0; transform: translate(-50%, -50%) scale(0) rotate(0deg); }
        40%  { opacity: 1; transform: translate(-50%, -50%) scale(1) rotate(90deg); }
        100% { opacity: 0; transform: translate(-50%, -50%) scale(0.5) rotate(180deg); }
    }

    @media (prefers-reduced-motion: reduce) {
        .shooting-stars { display: none; }
    }

</style>