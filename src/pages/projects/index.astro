---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';

const projects = (await getCollection('projects')).sort(
    (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
---

<BaseLayout title="Projects" description="Projects I've worked on, both CTF-related and otherwise.">
    <h1>Projects</h1>
    <div class="grid">
		{projects.map((project) => (
			<a href={`/projects/${project.id}/`} class="card project-card">
				<div class="project-left">
					<h2 class="title">{project.data.title}</h2>
					<span class="date"><FormattedDate date={project.data.pubDate} /></span>
				</div>
				<div class="project-right">
					<p class="description">{project.data.description}</p>
					<div class="stack">
						{project.data.stack?.map((tag) => (
							<span class={`tag tag-${tag.toLowerCase()}`}>{tag}</span>
						))}
					</div>
				</div>
			</a>
		))}
    </div>

    <style>

        main {
            max-width: 1100px;
            margin: 0 auto;
            padding: 4em 2em;
        }

        h1 {
            color: var(--accent);
            margin-bottom: 2em;
        }

        .grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 1rem;
        }

		.project-card {
			display: grid;
			grid-template-columns: 200px 1fr;
			align-items: center;
			padding: var(--space-6);
			gap: var(--space-6);
		}

		.project-left {
			display: flex;
			flex-direction: column;
			gap: var(--space-1);
		}

		.project-right {
			display: flex;
			flex-direction: column;
			gap: var(--space-3);
		}

		.description {
			font-size: 0.9rem;
			color: var(--text-muted);
			margin: 0;
		}

		.stack {
			display: flex;
			flex-wrap: wrap;
			gap: var(--space-2);
		}

		.tag {
			font-size: 0.7rem;
			padding: 0.15em 0.7em;
			border: 1px solid currentColor;
			border-radius: 999px;
			opacity: 0.85;
			white-space: nowrap;
		}

		@media (max-width: 720px) {
			.project-card { grid-template-columns: 1fr; gap: var(--space-3); }
		}

    </style>

</BaseLayout>